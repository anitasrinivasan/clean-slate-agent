{
  "name": "clean-slate-agent",
  "version": "1.0.0",
  "description": "An autonomous AI public defender for criminal record expungement",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "frontend:dev": "cd frontend && npx vite",
